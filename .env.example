# Development: use a local Postgres database / docker-compose.dev.yml
DATABASE_URL="postgresql://outlier:change_this_password@localhost:5432/outlier_academy?schema=public"

# Admin account: use a strong password and store only its bcrypt hash here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH"

# Generate with: openssl rand -base64 32
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
