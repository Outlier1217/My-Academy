generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  ARTICLE
  BLOG
  STORY
  MOCK_TEST
  COURSE
}

enum Subject {
  NISM
  NCFM
  FINANCE
  AI_ML
  BLOCKCHAIN
  DEFI
  MATHEMATICS
  GENERAL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  type            ContentType
  subject         Subject           @default(GENERAL)
  excerpt         String            @db.VarChar(500)
  body            String            @db.Text
  coverImageUrl   String?
  youtubeUrl      String?           @db.VarChar(2048)
  tags            String[]          @default([])
  questions       Json              @default("[]")
  durationMinutes Int?
  status          ContentStatus     @default(DRAFT)
  featured        Boolean           @default(false)
  readingMinutes  Int?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookmarks       Bookmark[]
  favourites      Favourite[]
  attempts        MockTestAttempt[]

  @@index([status, publishedAt])
  @@index([type, subject, status])
  @@index([featured, publishedAt])
}

model User {
  id              String            @id @default(cuid())
  name            String            @db.VarChar(100)
  email           String            @unique @db.VarChar(254)
  passwordHash    String
  profileImageUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookmarks       Bookmark[]
  favourites      Favourite[]
  attempts        MockTestAttempt[]

  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, createdAt])
  @@index([contentId])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, createdAt])
  @@index([contentId])
}

model MockTestAttempt {
  id              String   @id @default(cuid())
  userId          String
  contentId       String?
  testTitle       String   @db.VarChar(255)
  testSlug        String   @db.VarChar(255)
  score           Float
  maximumScore    Float
  percentage      Float
  passed          Boolean
  correctCount    Int
  wrongCount      Int
  unansweredCount Int
  result          Json
  shareToken      String?  @unique @default(cuid())
  createdAt       DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([contentId, createdAt])
}
